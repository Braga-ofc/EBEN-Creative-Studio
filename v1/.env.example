# Endereço público do site, sem barra no final. Obrigatório no build.
# Alimenta canonical, sitemap.xml, robots.txt, llms.txt e os dados estruturados.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# IDs das ferramentas de análise e de anúncios. Opcionais: sem o ID, a
# ferramenta fica desligada. São públicos e, no site publicado, ficam no
# netlify.toml. O rastreamento só liga no endereço de NEXT_PUBLIC_SITE_URL.
# Passo a passo em ../ANALYTICS_SETUP.md.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
